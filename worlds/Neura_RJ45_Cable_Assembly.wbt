#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/universal_robots/protos/UR5e.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/devices/robotiq/protos/Robotiq2f140Gripper.proto"

WorldInfo {
  basicTimeStep 16
  contactProperties [
    ContactProperties {
      material1 "ROBOTIQ gripper pad"
      material2 "plug_shell"
      coulombFriction 3
    }
    ContactProperties {
      material1 "cable_jacket"
      material2 "default"
      coulombFriction 0.35
    }
  ]
}
Viewpoint {
  orientation -0.1242579 -0.0817029 0.9888805 4.2946457
  position 1.032 2.797 0.934
}
TexturedBackground {}
TexturedBackgroundLight {}
RectangleArena { floorSize 2 2 }

UR5e {
  controller "rj45_cable_runner"
  supervisor TRUE
  toolSlot [
    Solid {
      children [
        Robotiq2f140Gripper {}
        # 相機裝在夾爪旁，畫面會以 Webots 相機視窗覆蓋於 3D 畫面。
        DEF PICKUP_CAMERA Camera {
          translation 0.06 0 0.12
          rotation 0 1 0 -1.5707963
          name "pickup_camera"
          width 320
          height 240
          fieldOfView 1.0
          recognition Recognition {
            maxRange 0.8
            frameColor 1 0.8 0.1
          }
        }
        DEF GRIPPER_GRASP_CONNECTOR Connector {
          translation 0 0 0.20
          name "gripper_grasp_latch"
          model "temporary_rj45_grasp"
          type "active"
          autoLock TRUE
          distanceTolerance 0.025
          axisTolerance 0.9
          numberOfRotations 0
          snap FALSE
        }
      ]
      name "gripper tool mount"
      boundingObject Sphere { radius 0.01 }
      physics Physics { density -1 mass 0.005 }
    }
  ]
}

# 路由器正面由上下左右四塊殼體組成，中央保留實際可碰撞的孔腔。
DEF ROUTER_PORT Solid {
  translation 0.57 0.25 0.30
  name "router ethernet port"
  children [
    Connector {
      translation -0.025 0 0
      rotation 0 0 1 3.14159265
      name "ethernet_port_latch"
      model "rj45_latch"
      type "passive"
    }
    DEF PORT_TOP Pose {
      translation -0.025 0 0.030
      children [ DEF RouterShell Shape {
        appearance PBRAppearance { baseColor 0.08 0.12 0.13 roughness 0.5 }
        geometry Box { size 0.05 0.09 0.026 }
      } ]
    }
    DEF PORT_BOTTOM Pose {
      translation -0.025 0 -0.030
      children [ USE RouterShell ]
    }
    DEF PORT_LEFT Pose {
      translation -0.025 0.040 0
      children [ DEF RouterSide Shape {
        appearance PBRAppearance { baseColor 0.10 0.15 0.16 roughness 0.5 }
        geometry Box { size 0.05 0.026 0.026 }
      } ]
    }
    DEF PORT_RIGHT Pose {
      translation -0.025 -0.040 0
      children [ USE RouterSide ]
    }
    Pose {
      translation 0.015 0 0
      children [ Shape {
        appearance PBRAppearance { baseColor 0.04 0.07 0.08 roughness 0.7 }
        geometry Box { size 0.03 0.09 0.08 }
      } ]
    }
  ]
  boundingObject Group {
    children [
      Pose { translation -0.025 0 0.030 children [ Box { size 0.05 0.09 0.026 } ] }
      Pose { translation -0.025 0 -0.030 children [ Box { size 0.05 0.09 0.026 } ] }
      Pose { translation -0.025 0.040 0 children [ Box { size 0.05 0.026 0.026 } ] }
      Pose { translation -0.025 -0.040 0 children [ Box { size 0.05 0.026 0.026 } ] }
      Pose { translation 0.015 0 0 children [ Box { size 0.03 0.09 0.08 } ] }
    ]
  }
}

# 有剛性的插頭本體；尾端連接被動球形關節組成的柔性線材。
DEF RJ45_PLUG Solid {
  translation 0.35 0.3 0.014
  rotation 0 0 1 0.261799388
  name "scaled RJ45 plug"
  contactMaterial "plug_shell"
  children [
    # 獨立視覺目標避免整條線材影響辨識框中心。
    Solid {
      translation 0 0 0.014
      name "plug visual target"
      model "rj45_grasp_target"
      recognitionColors [ 1 0.45 0.08 ]
      children [
        Shape {
          appearance PBRAppearance { baseColor 1 0.45 0.08 roughness 0.8 }
          geometry Box { size 0.012 0.018 0.002 }
        }
      ]
    }
    DEF PLUG_GRASP_CONNECTOR Connector {
      translation -0.015 0 0
      rotation 0 0 1 3.14159265
      name "rj45_grasp_point"
      model "temporary_rj45_grasp"
      type "passive"
    }
    # 護套另一側也可對接，供反向擺放時翻轉夾爪抓取。
    Connector {
      translation -0.015 0 0
      name "rj45_grasp_point_reverse"
      model "temporary_rj45_grasp"
      type "passive"
    }
    Connector {
      translation 0.025 0 0
      name "rj45_plug_latch"
      model "rj45_latch"
      type "active"
      isLocked TRUE
      autoLock TRUE
      distanceTolerance 0.03
      axisTolerance 0.85
      numberOfRotations 0
      snap TRUE
      tensileStrength 8
      shearStrength 8
    }
    Shape {
      appearance DEF PlugAppearance PBRAppearance {
        baseColor 0.65 0.76 0.83 transparency 0.35 roughness 0.35
      }
      geometry Box { size 0.05 0.024 0.018 }
    }
    Pose {
      translation -0.015 0 0
      children [ Shape {
        appearance PBRAppearance { baseColor 0.09 0.19 0.32 roughness 0.8 }
        geometry Box { size 0.025 0.04 0.024 }
      } ]
    }
    Pose {
      translation 0.023 0 0.004
      children [ Shape {
        appearance PBRAppearance { baseColor 0.76 0.59 0.2 metalness 0.7 roughness 0.3 }
        geometry Box { size 0.004 0.020 0.003 }
      } ]
    }
    Pose {
      translation -0.005 0 0.012
      children [ Shape {
        appearance USE PlugAppearance
        geometry Box { size 0.022 0.008 0.005 }
      } ]
    }
    BallJoint {
